<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#101010">
    <TextView
        android:id="@+id/castTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone Screen Cast"
        android:textSize="26sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp" />
    <TextView
        android:id="@+id/castStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start casting to share this phone's screen over the local network."
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="24dp" />
    <Button
        android:id="@+id/startCastButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Phone Cast"
        android:textAllCaps="false" />
    <Button
        android:id="@+id/closeCastButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Close"
        android:textAllCaps="false"
        android:layout_marginTop="12dp" />
</LinearLayout>
